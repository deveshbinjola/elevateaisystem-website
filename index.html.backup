<script>
// Rotating text
const words = ['Creators', 'Leaders', 'Coaches', 'Businesses', 'Consultants', 'Educators'];
let wordIndex = 0;
const rotEl = document.getElementById('rotatingText');

function rotateWord() {
  rotEl.style.opacity = '0';
  rotEl.style.transform = 'translateY(10px)';
  setTimeout(() => {
    wordIndex = (wordIndex + 1) % words.length;
    rotEl.textContent = words[wordIndex];
    rotEl.style.opacity = '1';
    rotEl.style.transform = 'translateY(0)';
  }, 300);
}
rotEl.style.transition = 'opacity .3s ease, transform .3s ease';
setInterval(rotateWord, 2500);

// Scroll reveal
const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('visible');
    }
  });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));

// ── SUPABASE CONFIG (Newsletter) ──
const SUPABASE_URL = 'https://modepuhwinzdngirlnkz.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1vZGVwdWh3aW56ZG5naXJsbmt6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI1MDYxNTEsImV4cCI6MjA4ODA4MjE1MX0.1S2wC8CxE8_MCTmsGwoiOoqNYw_lXIM7_CT_-AG6DAI';

// Newsletter signup
async function handleNewsletterSignup(e) {
  e.preventDefault();
  const form = document.getElementById('newsletterForm');
  const btn = form.querySelector('button');
  const email = form.querySelector('input[type="email"]').value;

  btn.disabled = true;
  btn.textContent = 'Subscribing...';

  try {
    // 1. Save to Supabase (source of truth)
    const response = await fetch(SUPABASE_URL + '/rest/v1/newsletter_subscribers', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify({
        email: email,
        source: 'homepage',
        subscribed_at: new Date().toISOString()
      })
    });

    if (!response.ok && response.status !== 409) {
      throw new Error('Signup failed');
    }

    // 2. Sync to Beehiiv (for email delivery)
    fetch('https://api.beehiiv.com/v2/publications/f390a157-1409-46d7-8d9e-1eff7e3a4d64/subscriptions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, reactivate_existing: true, send_welcome_email: true }),
      mode: 'no-cors'
    }).catch(() => {}); // Silent — Supabase is source of truth

    // Show success
    form.style.display = 'none';
    const note = form.nextElementSibling;
    if (note) note.style.display = 'none';
    document.getElementById('newsletterSuccess').style.display = 'block';

  } catch (err) {
    console.error('Newsletter signup error:', err);
    btn.disabled = false;
    btn.textContent = 'Subscribe to The 3-2-1';
    alert('Something went wrong — please try again.');
  }
}
</script>
</body>
