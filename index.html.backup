<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#FAFAF8;--bg-alt:#F2F2EE;--green:#00FF41;--green-dark:#00CC34;
  --navy:#0A0F1C;--navy-light:#1A2035;--text:#1A1A2E;--text-muted:#5A5A6E;
  --border:#E0E0D8;--white:#FFFFFF;--card-bg:#FFFFFF;
  --radius:12px;--radius-lg:20px;
}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideInLeft{from{opacity:0;transform:translateX(-40px)}to{opacity:1;transform:translateX(0)}}
@keyframes slideInRight{from{opacity:0;transform:translateX(40px)}to{opacity:1;transform:translateX(0)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@keyframes gradientShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
@keyframes typing{from{width:0}to{width:100%}}
.reveal{opacity:0;transform:translateY(30px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:translateY(0)}
.reveal-left{opacity:0;transform:translateX(-40px);transition:opacity .7s ease,transform .7s ease}
.reveal-left.visible{opacity:1;transform:translateX(0)}
.reveal-right{opacity:0;transform:translateX(40px);transition:opacity .7s ease,transform .7s ease}
.reveal-right.visible{opacity:1;transform:translateX(0)}






/* HERO */
.hero{padding:10rem 2rem 6rem;text-align:center;max-width:900px;margin:0 auto;position:relative}
.hero::before{content:'';position:absolute;top:80px;left:50%;transform:translateX(-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(0,255,65,.06) 0%,transparent 70%);border-radius:50%;pointer-events:none;z-index:-1}
.hero-badge{display:inline-flex;align-items:center;gap:.4rem;background:var(--bg-alt);color:var(--text);font-size:.8rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:.55rem 1.4rem;border-radius:50px;margin-bottom:2rem;border:1px solid var(--border);animation:fadeIn .8s ease .2s both}
.hero-badge svg{width:16px;height:16px;color:var(--green-dark)}
.hero h1{font-size:clamp(3.5rem,8vw,6.5rem);font-weight:800;line-height:1.02;letter-spacing:-.04em;color:var(--navy);margin-bottom:1.5rem;animation:fadeUp .8s ease .3s both}
.hero h1 .accent{color:var(--green-dark)}
.hero h1 .rotating-text{display:inline-block;position:relative;color:var(--navy);background:var(--green);padding:.1em .3em;min-width:240px}
.hero p{font-size:1.25rem;color:var(--text-muted);max-width:650px;margin:0 auto 2.5rem;line-height:1.7;font-style:italic;font-weight:400;animation:fadeUp .8s ease .5s both}
.hero-buttons{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;animation:fadeUp .8s ease .7s both}
.hero-cta{display:inline-flex;align-items:center;gap:.5rem;background:var(--navy);color:var(--white);padding:1rem 2.2rem;border-radius:10px;font-size:1rem;font-weight:700;transition:all .3s;border:none;cursor:pointer}
.hero-cta:hover{background:var(--navy-light);transform:translateY(-2px);box-shadow:0 8px 30px rgba(10,15,28,.2)}
.hero-cta svg{width:18px;height:18px}
.hero-cta-secondary{display:inline-flex;align-items:center;gap:.5rem;background:transparent;color:var(--navy);padding:1rem 2.2rem;border-radius:10px;font-size:1rem;font-weight:600;transition:all .3s;border:2px solid var(--border);cursor:pointer}
.hero-cta-secondary:hover{border-color:var(--navy);transform:translateY(-2px)}

/* TRUST BAR */
.trust-bar{padding:2rem 2rem 0;text-align:center;animation:fadeIn 1s ease 1s both}
.trust-bar p{font-size:.8rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);opacity:.5;margin-bottom:1rem}
.trust-logos{display:flex;gap:3rem;justify-content:center;align-items:center;flex-wrap:wrap;opacity:.35}
.trust-logos span{font-size:.85rem;font-weight:700;letter-spacing:.05em;color:var(--text-muted)}

/* SECTIONS */
.section{padding:6rem 2rem}
.section-inner{max-width:1100px;margin:0 auto}
.section-label{font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--green-dark);margin-bottom:.75rem}
.section-title{font-size:clamp(2.2rem,5vw,3.5rem);font-weight:800;line-height:1.08;letter-spacing:-.03em;color:var(--navy);margin-bottom:1rem}
.section-subtitle{font-size:1.05rem;color:var(--text-muted);max-width:620px;line-height:1.7}

/* FRICTION SECTION */
.friction{background:var(--bg-alt);position:relative;overflow:hidden}
.friction::after{content:'';position:absolute;top:-100px;right:-100px;width:400px;height:400px;background:radial-gradient(circle,rgba(0,255,65,.04),transparent 70%);border-radius:50%;pointer-events:none}
.friction-intro{font-size:1.1rem;color:var(--text);max-width:680px;margin-top:1rem;line-height:1.7}
.friction-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:3rem}
.friction-card{background:var(--card-bg);border-radius:var(--radius-lg);padding:2rem;border:1px solid var(--border);transition:all .4s;position:relative;overflow:hidden}
.friction-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.06);border-color:transparent}
.friction-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#DC2626,#F59E0B);opacity:0;transition:opacity .3s}
.friction-card:hover::before{opacity:1}
.friction-card .card-num{font-size:.7rem;font-weight:700;letter-spacing:.1em;color:var(--text-muted);text-transform:uppercase;margin-bottom:1rem;opacity:.5}
.friction-card h3{font-size:1.15rem;font-weight:700;color:var(--navy);margin-bottom:.6rem}
.friction-card p{font-size:.95rem;color:var(--text-muted);line-height:1.65}

/* LEAD OS SECTION */
.leados{position:relative}
.leados-header{text-align:center;margin-bottom:3rem}
.leados-header .section-subtitle{margin:0 auto}
.phase-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}
.phase-card{text-align:center;position:relative;padding:2rem}
.phase-num{width:56px;height:56px;background:var(--navy);color:var(--green);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:800;margin:0 auto 1.2rem;position:relative;z-index:2}
.phase-card h3{font-size:1.15rem;font-weight:700;color:var(--navy);margin-bottom:.5rem}
.phase-card p{font-size:.95rem;color:var(--text-muted);line-height:1.65}
.phase-connector{display:none}
@media(min-width:769px){
  .phase-connector{display:block;position:absolute;top:28px;right:-1rem;width:2rem;height:2px;background:var(--border)}
  .phase-card:last-child .phase-connector{display:none}
}

/* FRICTION REMOVAL */
.removal{background:var(--bg-alt)}
.removal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;margin-top:3rem}
.removal-card{background:var(--card-bg);border-radius:var(--radius-lg);padding:2rem;border:1px solid var(--border);display:flex;gap:1.2rem;align-items:flex-start;transition:all .3s}
.removal-card:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(0,0,0,.04)}
.removal-icon{flex-shrink:0;width:44px;height:44px;background:rgba(0,204,52,.1);border-radius:12px;display:flex;align-items:center;justify-content:center}
.removal-icon svg{width:20px;height:20px;color:var(--green-dark)}
.removal-card h3{font-size:1.05rem;font-weight:700;color:var(--navy);margin-bottom:.4rem}
.removal-card p{font-size:.9rem;color:var(--text-muted);line-height:1.6}

/* SERVICES */
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3rem}
.service-card{background:var(--card-bg);border-radius:var(--radius-lg);padding:2.5rem;border:1px solid var(--border);transition:all .4s;position:relative;overflow:hidden}
.service-card:hover{transform:translateY(-4px);box-shadow:0 16px 50px rgba(0,0,0,.06);border-color:transparent}
.service-card.featured{background:var(--navy);color:var(--white);border-color:transparent}
.service-card.featured:hover{box-shadow:0 16px 50px rgba(10,15,28,.3)}
.service-badge{display:inline-block;font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:.35rem .8rem;border-radius:50px;margin-bottom:1.2rem}
.service-card .service-badge{background:var(--bg-alt);color:var(--text-muted)}
.service-card.featured .service-badge{background:rgba(0,255,65,.15);color:var(--green)}
.service-card h3{font-size:1.4rem;font-weight:800;margin-bottom:.3rem}
.service-card.featured h3{color:var(--white)}
.service-price{font-size:.9rem;color:var(--text-muted);margin-bottom:1rem;font-weight:500}
.service-card.featured .service-price{color:rgba(255,255,255,.5)}
.service-card .service-desc{font-size:.95rem;color:var(--text-muted);line-height:1.65;margin-bottom:1.5rem}
.service-card.featured .service-desc{color:rgba(255,255,255,.7)}
.service-features{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.8rem}
.service-features li{display:flex;align-items:center;gap:.6rem;font-size:.88rem;color:var(--text);list-style:none}
.service-card.featured .service-features li{color:rgba(255,255,255,.8)}
.service-features li svg{width:16px;height:16px;color:var(--green-dark);flex-shrink:0}
.service-card.featured .service-features li svg{color:var(--green)}
.service-cta{display:inline-flex;align-items:center;gap:.4rem;font-size:.9rem;font-weight:700;color:var(--navy);transition:all .3s;padding:.7rem 1.4rem;border-radius:8px;border:2px solid var(--border)}
.service-cta:hover{border-color:var(--navy);transform:translateX(4px)}
.service-card.featured .service-cta{background:var(--green);color:var(--navy);border-color:var(--green)}
.service-card.featured .service-cta:hover{background:var(--green-dark);border-color:var(--green-dark);transform:translateX(4px)}

/* PHILOSOPHY */
.philosophy{background:var(--navy);color:var(--white);position:relative;overflow:hidden}
.philosophy::before{content:'';position:absolute;top:-200px;right:-200px;width:600px;height:600px;background:radial-gradient(circle,rgba(0,255,65,.06),transparent);border-radius:50%;pointer-events:none}
.philosophy .section-label{color:var(--green)}
.philosophy .section-title{color:var(--white)}
.philosophy-quote{font-size:1.3rem;font-weight:500;line-height:1.7;color:rgba(255,255,255,.85);max-width:700px;margin-top:2rem;position:relative;padding-left:1.5rem;border-left:3px solid var(--green)}
.philosophy-body{font-size:1rem;color:rgba(255,255,255,.55);max-width:700px;margin-top:1.5rem;line-height:1.75}
.pillars{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;margin-top:3rem}
.pillar{text-align:center;padding:1.5rem 1rem;border-radius:var(--radius);border:1px solid rgba(255,255,255,.08);transition:all .3s}
.pillar:hover{border-color:rgba(0,255,65,.2);background:rgba(0,255,65,.04)}
.pillar-icon{width:44px;height:44px;background:rgba(0,255,65,.1);border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto .8rem}
.pillar-icon svg{width:20px;height:20px;color:var(--green)}
.pillar h4{font-size:.9rem;font-weight:700;color:var(--white)}

/* CASE STUDIES */
.cases{background:var(--bg-alt)}
.case-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:3rem}
.case-card{background:var(--card-bg);border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--border);transition:all .4s}
.case-card:hover{transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.06)}
.case-header{background:var(--navy);color:var(--white);padding:1.5rem 2rem}
.case-label{font-size:.65rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--green);margin-bottom:.4rem}
.case-header h3{font-size:1.15rem;font-weight:700}
.case-body{padding:2rem}
.case-columns{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
.case-col h4{font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-bottom:.8rem}
.case-col.before h4{color:#DC2626}
.case-col.after h4{color:var(--green-dark)}
.case-col ul{list-style:none;display:flex;flex-direction:column;gap:.5rem}
.case-col li{font-size:.85rem;color:var(--text-muted);display:flex;align-items:flex-start;gap:.5rem}
.case-col li::before{content:'';width:5px;height:5px;border-radius:50%;flex-shrink:0;margin-top:7px}
.case-col.before li::before{background:#DC2626}
.case-col.after li::before{background:var(--green-dark)}
.case-context{margin-top:1.2rem;padding-top:1.2rem;border-top:1px solid var(--border);font-size:.85rem;color:var(--text-muted);font-style:italic}

/* PROCESS */
.process-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3rem}
.process-step{text-align:center;padding:2rem;position:relative}
.step-num{font-size:3rem;font-weight:800;color:var(--green);opacity:.2;line-height:1;margin-bottom:1rem}
.process-step h3{font-size:1.2rem;font-weight:700;color:var(--navy);margin-bottom:.5rem}
.process-step p{font-size:.95rem;color:var(--text-muted);line-height:1.65}

/* FIT CHECK */
.fit-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:3rem}
.fit-card{background:var(--card-bg);border-radius:var(--radius-lg);padding:2.5rem;border:1px solid var(--border)}
.fit-card h3{font-size:1.3rem;font-weight:700;margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem}
.fit-card.yes h3{color:var(--green-dark)}
.fit-card.no h3{color:#DC2626}
.fit-list{display:flex;flex-direction:column;gap:.8rem;list-style:none}
.fit-list li{display:flex;align-items:flex-start;gap:.75rem;font-size:.95rem;color:var(--text-muted)}
.fit-list li .dot{flex-shrink:0;width:6px;height:6px;border-radius:50%;margin-top:8px}
.fit-card.yes .dot{background:var(--green-dark)}
.fit-card.no .dot{background:#DC2626}

/* FOUNDER */
.founder{position:relative;overflow:hidden}
.founder::before{content:'';position:absolute;top:50%;left:0;transform:translateY(-50%);width:400px;height:400px;background:radial-gradient(circle,rgba(0,255,65,.05),transparent 70%);border-radius:50%;pointer-events:none}
.founder-grid{display:grid;grid-template-columns:280px 1fr;gap:3rem;align-items:center;margin-top:2.5rem}
.founder-photo{position:relative}
.founder-photo-frame{width:280px;height:340px;border-radius:var(--radius-lg);overflow:hidden;border:3px solid var(--border);position:relative;background:var(--bg-alt)}
.founder-photo-frame img{width:100%;height:100%;object-fit:cover}
.founder-photo-placeholder{width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.8rem;color:var(--text-muted)}
.founder-photo-placeholder svg{width:64px;height:64px;opacity:.3}
.founder-photo-placeholder span{font-size:.75rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;opacity:.4}
.founder-accent{position:absolute;bottom:-8px;right:-8px;width:100px;height:100px;border-radius:var(--radius);background:var(--green);opacity:.08;z-index:-1}
.founder-content h3{font-size:1.8rem;font-weight:800;color:var(--navy);margin-bottom:.3rem;line-height:1.2}
.founder-role{font-size:.85rem;font-weight:600;color:var(--green-dark);margin-bottom:1.2rem;display:flex;align-items:center;gap:.5rem}
.founder-role::before{content:'';width:20px;height:2px;background:var(--green-dark)}
.founder-story{font-size:1.05rem;color:var(--text-muted);line-height:1.75;margin-bottom:1.5rem}
.founder-values{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem}
.founder-value{display:inline-flex;align-items:center;gap:.4rem;font-size:.8rem;font-weight:600;color:var(--text);padding:.4rem .9rem;border-radius:50px;background:var(--bg-alt);border:1px solid var(--border)}
.founder-value svg{width:14px;height:14px;color:var(--green-dark)}
.founder-link{display:inline-flex;align-items:center;gap:.5rem;font-size:.9rem;font-weight:700;color:var(--navy);transition:all .3s}
.founder-link:hover{color:var(--green-dark);transform:translateX(4px)}
.founder-link svg{width:16px;height:16px}
@media(max-width:768px){
  .founder-grid{grid-template-columns:1fr;text-align:center}
  .founder-photo{display:flex;justify-content:center}
  .founder-photo-frame{width:200px;height:240px}
  .founder-values{justify-content:center}
}

/* NEWSLETTER */
.newsletter{background:var(--navy);position:relative;overflow:hidden}
.newsletter::before{content:'';position:absolute;top:-150px;right:-150px;width:500px;height:500px;background:radial-gradient(circle,rgba(0,255,65,.06),transparent);border-radius:50%;pointer-events:none}
.newsletter-inner{display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center}
.newsletter-content .section-label{color:var(--green)}
.newsletter-content .section-title{color:var(--white)}
.newsletter-desc{font-size:1.05rem;color:rgba(255,255,255,.6);line-height:1.7;margin-top:.8rem}
.newsletter-format{display:flex;gap:1.5rem;margin-top:1.5rem;flex-wrap:wrap}
.newsletter-format-item{display:flex;align-items:center;gap:.5rem}
.newsletter-format-num{width:32px;height:32px;border-radius:50%;background:rgba(0,255,65,.12);color:var(--green);font-size:.85rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.newsletter-format-text{font-size:.85rem;font-weight:600;color:rgba(255,255,255,.8)}
.newsletter-signup{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:var(--radius-lg);padding:2.5rem}
.newsletter-signup h3{font-size:1.3rem;font-weight:700;color:var(--white);margin-bottom:.3rem}
.newsletter-signup p{font-size:.9rem;color:rgba(255,255,255,.5);margin-bottom:1.5rem}
.newsletter-form{display:flex;flex-direction:column;gap:.6rem}
.newsletter-form input[type="email"]{padding:.9rem 1.2rem;border:2px solid rgba(255,255,255,.12);border-radius:10px;font-family:inherit;font-size:.95rem;background:rgba(255,255,255,.06);color:var(--white);outline:none;transition:border-color .3s}
.newsletter-form input[type="email"]:focus{border-color:var(--green)}
.newsletter-form input[type="email"]::placeholder{color:rgba(255,255,255,.35)}
.newsletter-form button{padding:.9rem 1.8rem;background:var(--green);color:var(--navy);border:none;border-radius:10px;font-family:inherit;font-size:.95rem;font-weight:700;cursor:pointer;transition:all .3s}
.newsletter-form button:hover{background:var(--green-dark);transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,255,65,.25)}
.newsletter-note{font-size:.72rem;color:rgba(255,255,255,.35);margin-top:.5rem}
.newsletter-success{display:none;text-align:center;padding:1.5rem;background:rgba(0,255,65,.08);border-radius:10px;border:1px solid rgba(0,255,65,.2)}
.newsletter-success h4{font-size:1.1rem;font-weight:700;color:var(--green);margin-bottom:.3rem}
.newsletter-success p{font-size:.88rem;color:rgba(255,255,255,.6)}
.newsletter-proof{display:flex;align-items:center;gap:.6rem;margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.08)}
.newsletter-proof svg{width:16px;height:16px;color:var(--green);flex-shrink:0}
.newsletter-proof span{font-size:.78rem;color:rgba(255,255,255,.4)}
@media(max-width:768px){
  .newsletter-inner{grid-template-columns:1fr}
  .newsletter-signup{padding:1.8rem}
}

/* FINAL CTA */

/* FOOTER */
.footer{padding:2.5rem 2rem;text-align:center;border-top:1px solid var(--border)}
.footer p{font-size:.82rem;color:var(--text-muted);font-weight:500}
.footer span{color:var(--green-dark)}

/* RESPONSIVE */
@media(max-width:1024px){
  .services-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:768px){
  .hero{padding:8rem 1.5rem 4rem}
  .hero h1{font-size:clamp(2.5rem,10vw,3.5rem)}
  .hero-buttons{flex-direction:column;align-items:center}
  .section{padding:4rem 1.5rem}
  .friction-grid{grid-template-columns:1fr}
  .phase-grid{grid-template-columns:1fr}
  .removal-grid{grid-template-columns:1fr}
  .services-grid{grid-template-columns:1fr}
  .pillars{grid-template-columns:repeat(2,1fr)}
  .case-grid{grid-template-columns:1fr}
  .case-columns{grid-template-columns:1fr}
  .process-steps{grid-template-columns:1fr}
  .fit-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<script src="navbar.js"></script>


<!-- HERO -->
<section class="hero">
  <div class="hero-badge"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg> Systems for Human Beings</div>
  <h1>AI Systems for<br><span class="rotating-text" id="rotatingText">Creators</span></h1>
  <p>Turn attention into real conversations — and conversations into clients.</p>
  <div class="hero-buttons">
    <a href="/seo-audit-landing-page" class="hero-cta">Get Your Free Search Audit <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
  </div>
</section>

<!-- THE FRICTION -->
<section class="section friction" id="friction">
  <div class="section-inner">
    <div class="section-label reveal">The Friction</div>
    <h2 class="section-title reveal">You've built something real.<br>But the leads don't reflect it.</h2>
    <p class="friction-intro reveal">Most coaches, consultants, businesses, and creators don't have a lead problem — they have a systems problem.</p>
    <div class="friction-grid">
      <div class="friction-card reveal" style="transition-delay:.1s">
        <div class="card-num">Problem 01</div>
        <h3>Content Without Capture</h3>
        <p>You're posting, sharing, showing up — but there's no mechanism to turn attention into an actual conversation. Visibility without a system is just noise.</p>
      </div>
      <div class="friction-card reveal" style="transition-delay:.2s">
        <div class="card-num">Problem 02</div>
        <h3>Leads Without Context</h3>
        <p>Someone fills out a form or sends a DM. But you don't know what they need, what they've seen, or how warm they are. Every call starts from zero.</p>
      </div>
      <div class="friction-card reveal" style="transition-delay:.3s">
        <div class="card-num">Problem 03</div>
        <h3>Follow-Up Without Flow</h3>
        <p>People show interest and then disappear — not because they weren't ready, but because nothing guided them forward. Without a system, follow-up dies.</p>
      </div>
    </div>
  </div>
</section>

<!-- LEAD OS INFRASTRUCTURE -->
<section class="section leados" id="leados">
  <div class="section-inner">
    <div class="leados-header">
      <div class="section-label reveal">The New Infrastructure</div>
      <h2 class="section-title reveal">Lead OS — Built for How You Work</h2>
      <p class="section-subtitle reveal">A system that captures trust, tracks readiness, and converts with integrity. No cold outreach. No manipulative funnels.</p>
    </div>
    <div class="phase-grid">
      <div class="phase-card reveal" style="transition-delay:.1s">
        <div class="phase-connector"></div>
        <div class="phase-num">01</div>
        <h3>Capture</h3>
        <p>A quiz, assessment, or lead asset that lets people experience your thinking before buying. They self-select. You get real data.</p>
      </div>
      <div class="phase-card reveal" style="transition-delay:.2s">
        <div class="phase-connector"></div>
        <div class="phase-num">02</div>
        <h3>Track</h3>
        <p>A centralized CRM that shows you who's warm, what they need, and where they are in their journey — without manual tagging or guesswork.</p>
      </div>
      <div class="phase-card reveal" style="transition-delay:.3s">
        <div class="phase-num">03</div>
        <h3>Convert</h3>
        <p>Automated nurture that feels personal. Sequences, follow-ups, and re-engagement — timed to readiness, not arbitrary schedules.</p>
      </div>
    </div>
  </div>
</section>

<!-- FRICTION REMOVAL -->
<section class="section removal" id="removal">
  <div class="section-inner">
    <div class="section-label reveal">What Gets Resolved</div>
    <h2 class="section-title reveal">Friction We Remove</h2>
    <div class="removal-grid">
      <div class="removal-card reveal" style="transition-delay:.1s">
        <div class="removal-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div>
        <div>
          <h3>Content</h3>
          <p>From scattered posting to strategic content that pre-qualifies and warms leads before they ever reach out.</p>
        </div>
      </div>
      <div class="removal-card reveal" style="transition-delay:.2s">
        <div class="removal-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <div>
          <h3>Leads</h3>
          <p>From "who is this?" to full context on every person — what they want, where they are, and whether they're ready.</p>
        </div>
      </div>
      <div class="removal-card reveal" style="transition-delay:.3s">
        <div class="removal-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
        <div>
          <h3>Decisions</h3>
          <p>From gut-feel follow-up to data-informed outreach — know exactly who to talk to and when.</p>
        </div>
      </div>
      <div class="removal-card reveal" style="transition-delay:.4s">
        <div class="removal-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/></svg></div>
        <div>
          <h3>Operations</h3>
          <p>From duct-taped tools to a single integrated system that runs while you do the real work.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="section" id="services">
  <div class="section-inner">
    <div class="section-label reveal">What We Build</div>
    <h2 class="section-title reveal">Services</h2>
    <div class="services-grid">

      <!-- Build Your Brand — TOP SERVICE -->
      <div class="service-card featured reveal" style="transition-delay:.1s">
        <div class="service-badge">Done-For-You · New</div>
        <h3>Build Your Brand</h3>
        <p class="service-price">From $5,000 · Brand + Website + AI Agents + Social</p>
        <p class="service-desc">Done-for-you brand building with up to 11 custom AI agents trained on your voice. Website, LinkedIn, Instagram, and a content machine that runs on autopilot.</p>
        <ul class="service-features">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Up to 11 custom AI agents (voice-trained)</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Website + LinkedIn + Instagram + content</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> ELEVATE Method optimized from day one</li>
        </ul>
        <a href="/build-your-brand" class="service-cta">Explore Build Your Brand →</a>
      </div>

      <!-- AI Strategy Hour -->
      <div class="service-card reveal" style="transition-delay:.2s">
        <div class="service-badge">AI Consultancy</div>
        <h3>AI Strategy Hour</h3>
        <p class="service-price">$375 · 60 Minutes · A Solution to Your Problem</p>
        <p class="service-desc">You've heard about AI everywhere. You don't know what actually applies to your business. One hour. Whatever problem you've got. You leave with an answer — no slides, no fluff.</p>
