<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#FAFAF8;--bg-alt:#F2F2EE;--green:#00FF41;--green-dark:#00CC34;
  --navy:#0A0F1C;--navy-light:#1A2035;--text:#1A1A2E;--text-muted:#5A5A6E;
  --border:#E0E0D8;--white:#FFFFFF;--card-bg:#FFFFFF;--radius:12px;--radius-lg:20px;
  --amber:#F59E0B;--amber-light:#FEF3C7;
  --purple:#8B5CF6;--purple-light:#EDE9FE;
  --teal:#0D9488;--teal-light:#CCFBF1;
}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans','Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);line-height:1.65;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}

/* ─── HERO ─── */
.hero{min-height:85vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:140px 24px 80px;position:relative;overflow:hidden;background:var(--navy)}
.hero::before{content:'';position:absolute;top:-30%;left:50%;transform:translateX(-50%);width:900px;height:900px;background:radial-gradient(circle,rgba(0,255,65,.08) 0%,transparent 65%);pointer-events:none}
.hero::after{content:'';position:absolute;bottom:-2px;left:0;right:0;height:80px;background:var(--bg);clip-path:ellipse(55% 100% at 50% 100%)}
.hero-inner{max-width:820px;position:relative;z-index:1}
.hero-badge{display:inline-block;padding:6px 18px;border:1px solid rgba(0,255,65,.3);border-radius:100px;font-size:13px;color:var(--green);letter-spacing:.5px;margin-bottom:28px;background:rgba(0,255,65,.06);font-weight:600}
.hero h1{font-size:clamp(2.2rem,5.5vw,3.4rem);font-weight:800;line-height:1.12;letter-spacing:-.03em;margin-bottom:24px;color:var(--white)}
.hero h1 em{font-style:normal;color:var(--green)}
.hero-sub{font-size:1.15rem;color:rgba(255,255,255,.65);max-width:680px;margin:0 auto 32px;line-height:1.7}
.hero-cta{display:inline-flex;align-items:center;gap:10px;padding:16px 36px;background:var(--green);color:var(--navy);font-weight:800;font-size:1rem;border-radius:50px;transition:all .3s;letter-spacing:.02em}
.hero-cta:hover{background:var(--green-dark);transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,255,65,.25)}
.hero-cta svg{width:18px;height:18px}
.platform-badges{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:36px}
.platform-badges span{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);padding:8px 18px;border-radius:8px;font-size:13px;font-weight:600;color:rgba(255,255,255,.7)}
.platform-badges .web{border-color:rgba(0,255,65,.4);color:var(--green)}
.platform-badges .lin{border-color:rgba(10,102,194,.5);color:#7eb8f0}
.platform-badges .ig{border-color:rgba(225,48,108,.5);color:#f0a0be}
.platform-badges .ai{border-color:rgba(139,92,246,.5);color:#c4b5fd}
.hero-stat-row{display:flex;gap:32px;justify-content:center;margin-top:36px;flex-wrap:wrap}
.hero-stat{text-align:center}
.hero-stat .num{font-size:2rem;font-weight:800;color:var(--green);display:block;line-height:1}
.hero-stat .label{font-size:.72rem;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-top:4px;display:block}

/* ─── SECTIONS ─── */
section{padding:80px 24px}
.container{max-width:960px;margin:0 auto}
.section-label{font-size:.7rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--green-dark);margin-bottom:.6rem}
.section-title{font-size:clamp(1.6rem,4vw,2.2rem);font-weight:800;letter-spacing:-.02em;margin-bottom:16px;color:var(--navy);line-height:1.15}
.section-sub{color:var(--text-muted);font-size:1.05rem;max-width:640px;line-height:1.7}

/* ─── PAIN POINTS ─── */
.pain{text-align:center;background:var(--white);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.pain p{font-size:1.1rem;color:var(--text-muted);margin-bottom:16px;max-width:640px;margin-left:auto;margin-right:auto;line-height:1.7}
.pain strong{color:var(--navy)}

/* ─── AI AGENTS SECTION ─── */
.agents-section{background:var(--navy);color:var(--white)}
.agents-section .section-label{color:var(--green)}
.agents-section .section-title{color:var(--white)}
.agents-section .section-sub{color:rgba(255,255,255,.6)}
.agent-category{margin-top:40px}
.agent-category-label{display:inline-block;font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 12px;border-radius:6px;margin-bottom:16px}
.agent-category-label.content{background:rgba(0,255,65,.12);color:var(--green)}
.agent-category-label.ops{background:rgba(139,92,246,.15);color:#c4b5fd}
.agent-category-label.growth{background:rgba(245,158,11,.15);color:#fbbf24}
.agent-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px}
.agent-card{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius);padding:20px;transition:transform .2s,border-color .2s}
.agent-card:hover{transform:translateY(-2px);border-color:rgba(0,255,65,.3)}
.agent-card h4{font-size:.92rem;font-weight:700;color:var(--white);margin-bottom:4px;display:flex;align-items:center;gap:8px}
.agent-card h4 .icon{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.75rem;flex-shrink:0}
.agent-card p{font-size:.82rem;color:rgba(255,255,255,.5);line-height:1.55}
.agent-card .tier-tag{display:inline-block;font-size:.6rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 8px;border-radius:4px;margin-top:8px;background:rgba(255,255,255,.06);color:rgba(255,255,255,.4)}

/* ─── PHASES ─── */
.phases{background:var(--bg-alt)}
.phase-grid{display:flex;flex-direction:column;gap:24px;margin-top:40px}
.phase-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius-lg);padding:32px;transition:transform .2s,box-shadow .2s;display:grid;grid-template-columns:64px 1fr;gap:24px;align-items:start}
.phase-card:hover{transform:translateY(-3px);box-shadow:0 8px 30px rgba(0,0,0,.06)}
.phase-num{width:64px;height:64px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:800;color:var(--white);flex-shrink:0}
.phase-card h3{font-size:1.1rem;font-weight:800;color:var(--navy);margin-bottom:4px}
.phase-meta{font-size:.78rem;font-weight:600;color:var(--text-muted);margin-bottom:10px;text-transform:uppercase;letter-spacing:.05em}
.phase-card p{font-size:.92rem;color:var(--text-muted);line-height:1.7}
.phase-card ul{list-style:none;margin-top:10px;display:flex;flex-wrap:wrap;gap:8px}
.phase-card ul li{font-size:.8rem;padding:4px 12px;border-radius:6px;background:var(--bg-alt);color:var(--text-muted);font-weight:500;border:1px solid var(--border)}
.phase-card ul li.agent-tag{background:rgba(0,204,52,.08);color:var(--green-dark);border-color:rgba(0,204,52,.2)}

/* ─── PRICING ─── */
.pricing-section{background:var(--white);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;margin-top:40px}
.pricing-card{background:var(--card-bg);border:2px solid var(--border);border-radius:var(--radius-lg);padding:32px;position:relative;transition:transform .2s,box-shadow .2s}
.pricing-card:hover{transform:translateY(-3px);box-shadow:0 8px 30px rgba(0,0,0,.06)}
.pricing-card.featured{border-color:var(--green-dark);box-shadow:0 4px 24px rgba(0,204,52,.12)}
.pricing-card.featured::before{content:'MOST POPULAR';position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--green-dark);color:var(--white);font-size:.65rem;font-weight:800;letter-spacing:.1em;padding:5px 14px;border-radius:20px}
.pricing-name{font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px}
.pricing-price{font-size:2.5rem;font-weight:800;color:var(--navy);margin-bottom:4px;line-height:1}
.pricing-desc{font-size:.9rem;color:var(--text-muted);margin-bottom:20px;line-height:1.6}
.pricing-agent-count{display:inline-block;font-size:.7rem;font-weight:800;letter-spacing:.05em;padding:4px 10px;border-radius:6px;background:rgba(0,204,52,.08);color:var(--green-dark);margin-bottom:16px}
.pricing-list{list-style:none;padding:0;margin-bottom:24px}
.pricing-list li{font-size:.88rem;padding:8px 0;border-top:1px solid var(--border);padding-left:1.5rem;position:relative;color:var(--text)}
.pricing-list li::before{content:"\2713";position:absolute;left:0;font-weight:700;color:var(--green-dark)}
.pricing-list li.excluded{color:var(--text-muted);opacity:.45}
.pricing-list li.excluded::before{content:"\2717";color:var(--text-muted)}
.pricing-list li.agent-item{color:var(--green-dark);font-weight:600}
.pricing-cta{display:block;width:100%;padding:14px;text-align:center;border-radius:50px;font-weight:800;font-size:.92rem;transition:all .3s;border:none;cursor:pointer;font-family:inherit}
.pricing-cta.primary{background:var(--green);color:var(--navy)}
.pricing-cta.primary:hover{background:var(--green-dark);transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,255,65,.25)}
.pricing-cta.secondary{background:transparent;color:var(--navy);border:2px solid var(--border)}
.pricing-cta.secondary:hover{border-color:var(--green-dark);color:var(--green-dark);transform:translateY(-2px)}
.pricing-timeline{font-size:.78rem;color:var(--text-muted);text-align:center;margin-top:10px}

/* ─── ROI ─── */
.roi-section{background:var(--bg-alt);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.roi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:20px;margin-top:32px}
.roi-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);padding:24px;text-align:center}
.roi-card .replace{font-size:.78rem;color:var(--text-muted);margin-bottom:4px}
.roi-card .cost{font-size:1.3rem;font-weight:800;color:var(--navy);text-decoration:line-through;text-decoration-color:rgba(239,68,68,.5)}
.roi-card .you-pay{font-size:.78rem;font-weight:700;color:var(--green-dark);margin-top:6px}
.roi-total{text-align:center;margin-top:32px;padding:28px;background:var(--card-bg);border:2px solid var(--green-dark);border-radius:var(--radius-lg)}
.roi-total .old{font-size:1rem;color:var(--text-muted);margin-bottom:4px}
.roi-total .old span{text-decoration:line-through;font-weight:700;color:var(--navy)}
.roi-total .new{font-size:1.3rem;font-weight:800;color:var(--green-dark)}

/* ─── WHAT MAKES DIFFERENT ─── */
.diff-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:32px}
.diff-card{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);padding:24px;transition:transform .2s}
.diff-card:hover{transform:translateY(-3px);box-shadow:0 8px 30px rgba(0,0,0,.06)}
.diff-card .tag{display:inline-block;font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:3px 8px;border-radius:4px;margin-bottom:10px;background:rgba(0,204,52,.1);color:var(--green-dark)}
.diff-card h3{font-size:1rem;font-weight:700;color:var(--navy);margin-bottom:6px}
.diff-card p{font-size:.88rem;color:var(--text-muted);line-height:1.6}

/* ─── CTA SECTION ─── */
.cta-section{background:var(--navy);text-align:center;color:var(--white)}
.cta-section h2{font-size:clamp(1.6rem,4vw,2.2rem);font-weight:800;margin-bottom:12px;color:var(--white)}
.cta-section p{font-size:1rem;color:rgba(255,255,255,.65);max-width:600px;margin:0 auto 28px;line-height:1.7}

/* ─── FAQ ─── */
.faq-grid{display:flex;flex-direction:column;gap:16px;margin-top:32px;max-width:720px}
.faq-item{background:var(--card-bg);border:1px solid var(--border);border-radius:var(--radius);padding:24px}
.faq-item h3{font-size:1rem;font-weight:700;color:var(--navy);margin-bottom:6px}
.faq-item p{font-size:.9rem;color:var(--text-muted);line-height:1.6}

/* ─── FOOTER ─── */
.footer{padding:2.5rem 2rem;text-align:center;border-top:1px solid var(--border)}
.footer p{font-size:.82rem;color:var(--text-muted);font-weight:500}
.footer span{color:var(--green-dark)}

/* ─── ANIMATIONS ─── */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .7s,transform .7s}
.reveal.visible{opacity:1;transform:translateY(0)}

/* ─── RESPONSIVE ─── */
@media(max-width:768px){
  .hero{padding:120px 20px 60px;min-height:auto}
  .hero h1{font-size:clamp(1.8rem,8vw,2.6rem)}
  .hero-stat-row{gap:20px}
  .hero-stat .num{font-size:1.5rem}
  .phase-card{grid-template-columns:1fr;gap:16px}
  .phase-num{width:48px;height:48px;font-size:1.1rem;border-radius:12px}
  .pricing-grid{grid-template-columns:1fr}
  .agent-grid{grid-template-columns:1fr}
  .roi-grid{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>

<!-- ─── NAVBAR ─── -->
<script src="navbar.js"></script>

<!-- ─── HERO ─── -->
<div class="hero">
  <div class="hero-inner">
    <div class="hero-badge">Brand + AI Agents — Done For You</div>
    <h1>We'll <em>Build Your Brand</em> and Give You AI Agents to Run It</h1>
    <div class="platform-badges">
      <span class="web">Website</span>
      <span class="lin">LinkedIn</span>
      <span class="ig">Instagram</span>
      <span class="ai">AI Agents</span>
    </div>
    <p class="hero-sub">A done-for-you brand building service with custom AI agents trained on your voice. We build your website, social presence, and content pipeline — then hand you AI agents that create content, manage operations, and grow your visibility on autopilot.</p>
    <a href="https://cal.com/sunny-binjola/discovery-call" class="hero-cta">Book a Discovery Call <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
    <div class="hero-stat-row">
      <div class="hero-stat"><span class="num">11</span><span class="label">Custom AI Agents</span></div>
      <div class="hero-stat"><span class="num">3</span><span class="label">Platforms Launched</span></div>
      <div class="hero-stat"><span class="num">4</span><span class="label">Search Channels</span></div>
    </div>
  </div>
</div>

<!-- ─── PAIN ─── -->
<section class="pain reveal">
  <div class="container" style="text-align:center">
    <div class="section-label">The Problem</div>
    <h2 class="section-title">You're Running a Coaching Business With Zero Systems</h2>
    <p>You've built something real. Clients love your work. But behind the scenes? <strong>You're doing everything manually.</strong> Writing every post. Sending every email. Managing every booking. Scrambling to stay visible.</p>
    <p>Your website is outdated — or doesn't exist. Your LinkedIn is a resume from 2019. Your Instagram has 3 posts from last year. And when someone asks ChatGPT to recommend a coach in your niche — you're nowhere.</p>
    <p>You've thought about hiring a VA, a content writer, a social media manager. <strong>That's $5,000+/month.</strong> And you'd still have to manage all of them.</p>
    <p><strong>What if you could replace all of that with AI agents trained on YOUR voice — and get your entire brand built at the same time?</strong></p>
  </div>
</section>

<!-- ─── AI AGENTS ─── -->
<section class="agents-section reveal">
  <div class="container">
    <div class="section-label">Your AI Team</div>
    <h2 class="section-title">11 Custom AI Agents. Trained on You.</h2>
    <p class="section-sub">Every agent learns your voice, your brand, your methodology. They don't sound like AI — they sound like you on your best day.</p>

    <div class="agent-category">
      <div class="agent-category-label content">Content Agents</div>
      <div class="agent-grid">
        <div class="agent-card reveal">
          <h4><span class="icon" style="background:rgba(0,255,65,.12);color:var(--green)">B</span> Blog Agent</h4>
          <p>Drop in an idea or voice note. Get back a full SEO-optimized blog post in your voice — with schema, meta tags, internal links.</p>
          <span class="tier-tag">All tiers</span>
        </div>
        <div class="agent-card reveal">
          <h4><span class="icon" style="background:rgba(0,255,65,.12);color:var(--green)">C</span> Caption Agent</h4>
          <p>One idea becomes captions for LinkedIn, Instagram, and X — each adapted to platform norms and your voice.</p>
          <span class="tier-tag">All tiers</span>
        </div>
        <div class="agent-card reveal">
          <h4><span class="icon" style="background:rgba(0,255,65,.12);color:var(--green)">Ca</span> Carousel Agent</h4>
          <p>Turns any blog post or idea into branded LinkedIn/Instagram carousels. Your colours, your fonts, ready to post.</p>
          <span class="tier-tag">Launch +</span>
        </div>
        <div class="agent-card reveal">
          <h4><span class="icon" style="background:rgba(0,255,65,.12);color:var(--green)">N</span> Newsletter Agent</h4>
          <p>Pulls from your week's content and generates a formatted newsletter draft. Works with Beehiiv, ConvertKit, or Mailchimp.</p>
          <span class="tier-tag">Launch +</span>
        </div>
        <div class="agent-card reveal">
          <h4><span class="icon" style="background:rgba(0,255,65,.12);color:var(--green)">S</span> Story Agent</h4>
          <p>Repurposes content into branded Instagram story sequences — hooks, text overlays, swipe-up CTAs.</p>
          <span class="tier-tag">Launch +</span>
        </div>
      </div>
    </div>

    <div class="agent-category" style="margin-top:32px">
      <div class="agent-category-label ops">Operations Agents</div>
      <div class="agent-grid">
        <div class="agent-card reveal">
          <h4><span class="icon" style="background:rgba(139,92,246,.12);color:#a78bfa">Cal</span> Calendar Agent</h4>
          <p>Manages bookings, sends prep reminders, handles rescheduling, nudges no-shows. Connected to Cal.com or Calendly.</p>
          <span class="tier-tag">Launch +</span>
        </div>
        <div class="agent-card reveal">
